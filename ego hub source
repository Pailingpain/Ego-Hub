local _dummyPart = Instance.new("Part")
_dummyPart.Anchored   = true
_dummyPart.CanCollide = false
_dummyPart.Parent     = nil

local function HasLineOfSight(targetPos)
    local lc = LocalPlayer.Character
    local lh = lc and lc:FindFirstChild("Head")
    if not lh then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { lc }
    local res = Workspace:Raycast(lh.Position, (targetPos - lh.Position), params)
    return not res
end

local function GetNearestToMouse(fov, teamCheck, wallCheck)
    local best, bestDst = nil, fov
    local mPos = UserInputService:GetMouseLocation()

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if teamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then continue end

        local char = p.Character
        if not char then continue end
        local part = char:FindFirstChild(Config.SilentAim.TargetPart) or char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end

        if wallCheck and not HasLineOfSight(part.Position) then continue end

        local sc, onSc = Camera:WorldToViewportPoint(part.Position)
        if not onSc then continue end

        local d = (mPos - Vector2.new(sc.X, sc.Y)).Magnitude
        if d < bestDst then bestDst = d; best = p end
    end
    return best
end

local function PredictPos(character, amount, method)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local v = hrp.AssemblyLinearVelocity
    method   = method or "Velocity"

    if method == "Velocity" then
        return hrp.Position + v * amount

    elseif method == "HRPChecking" then
        return hrp.Position + v * (math.clamp(v.Magnitude / 20, 0, 1) * amount)

    elseif method == "Raycast" then
        if v.Magnitude < 0.1 then return hrp.Position end
        local dir    = v.Unit * amount * 20
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character, LocalPlayer.Character or _dummyPart }
        local res = Workspace:Raycast(hrp.Position, dir, params)
        return res and res.Position or (hrp.Position + dir)

    elseif method == "Hybrid" then
        if v.Magnitude > 15 then
            return hrp.Position + v * amount
        else
            return hrp.Position + v * amount * 0.5
        end
    end

    return hrp.Position
end

local function ShouldRedirect()
    if not Config.SilentAim.Enabled then return false end
    if Config.SilentAim.HitChance >= 100 then return true end
    return math.random(1, 100) <= Config.SilentAim.HitChance
end

local function ResolveRedirectPos()
    local target = GetNearestToMouse(
        Config.SilentAim.FOV,
        Config.SilentAim.TeamCheck,
        Config.SilentAim.WallCheck
    )
    if not target then return nil end
    local char = target.Character
    if not char then return nil end
    local part = char:FindFirstChild(Config.SilentAim.TargetPart) or char:FindFirstChild("HumanoidRootPart")
    if not part then return nil end

    local pos = part.Position
    if Config.SilentAim.Prediction then
        pos = PredictPos(char, Config.SilentAim.PredictionAmount, Config.SilentAim.PredictionMethod)
            or part.Position
    end
    return pos
end

local _cachedRedirectPos = nil
local _cacheFrame        = 0

local function GetCachedRedirect()
    local now = tick()
    if _cacheFrame == 0 or (now - _cacheFrame) > (1 / 240) then
        _cacheFrame = now
        if ShouldRedirect() then
            _cachedRedirectPos = ResolveRedirectPos()
        else
            _cachedRedirectPos = nil
        end
    end
    return _cachedRedirectPos
end

local function UpdateSilentAimFOV()
    if not SilentAimFOV then return end
    if Config.SilentAim.Enabled and Config.SilentAim.FOVVisible then
        SilentAimFOV.Visible  = true
        SilentAimFOV.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        SilentAimFOV.Radius   = Config.SilentAim.FOV
        SilentAimFOV.Color    = CT()
    else
        SilentAimFOV.Visible = false
    end
end

if hasHookMeta then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args   = { ... }

        if Config.SilentAim.Enabled then

            if method == "Raycast" and self == Workspace then
                local pos = GetCachedRedirect()
                if pos and args[1] and args[2] then
                    args[2] = pos - args[1]
                    return oldNamecall(self, table.unpack(args))
                end
            end

            if (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and self == Workspace then
                local pos = GetCachedRedirect()
                if pos and args[1] then
                    local r           = args[1]
                    local origin      = r.Origin
                    local dir         = pos - origin
                    local originalLen = r.Direction.Magnitude
                    args[1] = Ray.new(origin, dir.Unit * math.min(dir.Magnitude, originalLen))
                    return oldNamecall(self, table.unpack(args))
                end
            end

            if method == "ViewportPointToRay" and self == Camera then
                local pos = GetCachedRedirect()
                if pos then
                    local origin = Camera.CFrame.Position
                    return Ray.new(origin, (pos - origin).Unit * 1000)
                end
            end

        end

        return oldNamecall(self, ...)
    end)
end

RunService.Heartbeat:Connect(function()
    if not Config.SilentAim.Enabled then
        _cachedRedirectPos = nil
        _cacheFrame        = 0
        return
    end
    if ShouldRedirect() then
        _cachedRedirectPos = ResolveRedirectPos()
    else
        _cachedRedirectPos = nil
    end
    if _cachedRedirectPos then
        pcall(function() Mouse.Hit = CFrame.new(_cachedRedirectPos) end)
    end
end)

