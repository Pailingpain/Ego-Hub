local function DisableObj(obj)
    if not Config.AntiLag.Enabled then return end
    pcall(function()
        local c = obj.ClassName
        if (c == "ParticleEmitter" and Config.AntiLag.RemoveParticles)
        or (c == "Fire" and Config.AntiLag.RemoveFire)
        or (c == "Smoke" and Config.AntiLag.RemoveSmoke)
        or (c == "Beam" and Config.AntiLag.RemoveBeams)
        or (c == "Sparkles" and Config.AntiLag.RemoveSparks)
        or (c == "Trail" and Config.AntiLag.RemoveTrails)
        or (c == "Explosion" and Config.AntiLag.RemoveExplosions) then
            obj.Enabled = false
            if c == "Explosion" then obj.Visible = false; obj.BlastPressure = 0; obj.BlastRadius = 0 end
        end
        if Config.AntiLag.RemoveTextures and (c == "Texture" or c == "Decal") then
            obj.Transparency = 1
        end
    end)
end

local function ApplyAntiLag()
    if not Config.AntiLag.Enabled then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do DisableObj(obj) end
end

Workspace.DescendantAdded:Connect(function(obj)
    if not Config.AntiLag.Enabled then return end
    task.defer(function() DisableObj(obj) end)
end)

-- Run anti-lag scan loop every 2s while enabled
task.spawn(function()
    while task.wait(2) do
        if Config.AntiLag.Enabled then ApplyAntiLag() end
    end
end)

