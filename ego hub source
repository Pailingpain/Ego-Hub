local function Slider(page, lbl, desc, min, max, default, cb)
    local val = default or min
    local row = Create("Frame", {
        Size = UDim2.new(1,0,0,58),
        BackgroundColor3 = Color3.fromRGB(14,18,32),
        BackgroundTransparency = 0.3, ZIndex = 13, Parent = page,
    })
    Corner(row, 8)
    Create("UIStroke", { Color = Color3.fromRGB(35,45,80), Thickness = 1, Transparency = 0.3, Parent = row })

    Create("TextLabel", {
        Size = UDim2.new(1,-70,0,18), Position = UDim2.new(0,10,0,6),
        BackgroundTransparency = 1, Text = lbl,
        TextColor3 = Color3.fromRGB(205,215,240),
        Font = Enum.Font.GothamSemibold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 14, Parent = row,
    })
    local valL = Create("TextLabel", {
        Size = UDim2.new(0,60,0,18), Position = UDim2.new(1,-65,0,6),
        BackgroundTransparency = 1, Text = tostring(val),
        TextColor3 = CT(), Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 14, Parent = row,
    })
    RegisterThemed(valL, "TextColor3", "accent")

    if desc and desc ~= "" then
        Create("TextLabel", {
            Size = UDim2.new(1,-20,0,12), Position = UDim2.new(0,10,0,24),
            BackgroundTransparency = 1, Text = desc,
            TextColor3 = Color3.fromRGB(70,85,130), Font = Enum.Font.Gotham,
            TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 14, Parent = row,
        })
    end

    -- Make bar bigger / easier to grab
    local barBG = Create("Frame", {
        Size = UDim2.new(1,-20,0,10), Position = UDim2.new(0,10,1,-16),
        BackgroundColor3 = Color3.fromRGB(35,40,70),
        ZIndex = 14, Parent = row, Active = true,
    })
    Corner(barBG, 5)
    local fill = Create("Frame", {
        Size = UDim2.new((val-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = CT(),
        ZIndex = 15, Parent = barBG,
    })
    Corner(fill, 5)
    RegisterThemed(fill, "BackgroundColor3", "accent")

    local sliding = false
    local moveConn, endConn

    local function update(inputPos)
        local rel = math.clamp((inputPos.X - barBG.AbsolutePosition.X) / barBG.AbsoluteSize.X, 0, 1)
        val = math.floor(min + rel * (max - min) + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valL.Text = tostring(val)
        if cb then cb(val) end
    end

    barBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(input.Position)

            if moveConn then moveConn:Disconnect() end
            moveConn = UserInputService.InputChanged:Connect(function(inp)
                if not sliding then return end
                if inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch then
                    update(inp.Position)
                end
            end)

            if endConn then endConn:Disconnect() end
            endConn = UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                    if moveConn then moveConn:Disconnect(); moveConn = nil end
                    if endConn then endConn:Disconnect(); endConn = nil end
                end
            end)
        end
    end)
end

