--   FEATURE: CAM/AIM LOCK (Fixed via BindToRenderStep)
-- ============================================================

local function GetNearestPlayer(fromPos, maxDist, teamCheck)
    local best, bestDst = nil, maxDist or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if teamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then continue end
        local char = p.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        local d = (hrp.Position - fromPos).Magnitude
        if d < bestDst then bestDst = d; best = p end
    end
    return best
end

local function CamLockStep()
    if not Config.CamLock.Enabled or not Config.CamLock.Active then return end
    local target = Config.CamLock.Target
    if not target then return end
    local char = target.Character
    if not char then
        if Config.CamLock.BreakOnDead then Config.CamLock.Active=false; Config.CamLock.Target=nil end
        return
    end
    local part = char:FindFirstChild(Config.CamLock.TargetPart) or char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not part or (hum and hum.Health <= 0) then
        Config.CamLock.Active=false; Config.CamLock.Target=nil
        return
    end
    local pos = part.Position
    if Config.CamLock.Prediction then
        pos = PredictPos(char, Config.CamLock.PredictionAmount, "Velocity") or pos
    end
    local newCF = CFrame.lookAt(Camera.CFrame.Position, pos)
    Camera.CFrame = Camera.CFrame:Lerp(newCF, Config.CamLock.SmoothFactor)
end

local function AimLockStep()
    if not Config.AimLock.Enabled or not Config.AimLock.Active then return end
    local target = Config.AimLock.Target
    if not target then
        if Config.AimLock.AutoLock then
            local lc = LocalPlayer.Character
            local lh = lc and lc:FindFirstChild("HumanoidRootPart")
            if lh then
                Config.AimLock.Target = GetNearestPlayer(lh.Position, Config.AimLock.MaxDistance, Config.AimLock.TeamCheck)
            end
        end
        return
    end
    local char = target.Character
    if not char then Config.AimLock.Target=nil; return end
    local part = char:FindFirstChild(Config.AimLock.TargetPart) or char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not part or (hum and hum.Health <= 0) then
        Config.AimLock.Target = nil
        return
    end
    local pos = part.Position
    if Config.AimLock.Prediction then
        pos = PredictPos(char, Config.AimLock.PredictionAmount, "Velocity") or pos
    end
    local newCF = CFrame.lookAt(Camera.CFrame.Position, pos)
    Camera.CFrame = Camera.CFrame:Lerp(newCF, Config.AimLock.SmoothFactor)
end

-- Bind AFTER Roblox's camera step so we override the default camera
RunService:BindToRenderStep("EgoHub_CamLock", Enum.RenderPriority.Camera.Value + 1, CamLockStep)
RunService:BindToRenderStep("EgoHub_AimLock", Enum.RenderPriority.Camera.Value + 2, AimLockStep)

