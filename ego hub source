local fpsFrames, fpsTimer, currentFPS = 0, 0, 0

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q and Config.CamLock.Enabled then
        Config.CamLock.Active = not Config.CamLock.Active
        if Config.CamLock.Active then
            local lc = LocalPlayer.Character
            local lh = lc and lc:FindFirstChild("HumanoidRootPart")
            if lh then Config.CamLock.Target = GetNearestPlayer(lh.Position, Config.CamLock.MaxDistance, Config.CamLock.TeamCheck) end
        else Config.CamLock.Target = nil end
    end
    if input.KeyCode == Enum.KeyCode.E and Config.AimLock.Enabled then
        Config.AimLock.Active = not Config.AimLock.Active
        if Config.AimLock.Active then
            local lc = LocalPlayer.Character
            local lh = lc and lc:FindFirstChild("HumanoidRootPart")
            if lh then Config.AimLock.Target = GetNearestPlayer(lh.Position, Config.AimLock.MaxDistance, Config.AimLock.TeamCheck) end
        else Config.AimLock.Target = nil end
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    Config.CamLock.Active=false; Config.CamLock.Target=nil
    Config.AimLock.Active=false; Config.AimLock.Target=nil
end)

RunService.RenderStepped:Connect(function(dt)
    fpsFrames = fpsFrames + 1
    fpsTimer = fpsTimer + dt
    if fpsTimer >= 0.5 then
        currentFPS = math.floor(fpsFrames / fpsTimer)
        fpsFrames = 0; fpsTimer = 0
    end
    UpdateESP()
    UpdateSilentAimFOV()
end)

