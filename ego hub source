    local iconF = Create("Frame", {
        Size = UDim2.new(0,22,0,22), Position = UDim2.new(0,8,0.5,-11),
        BackgroundColor3 = CT(), BackgroundTransparency = 0.75,
        ZIndex = 14, Parent = btn,
    })
    Corner(iconF, 6)
    RegisterThemed(iconF, "BackgroundColor3", "accent")

    Create("TextLabel", {
        Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
        Text = def.icon, TextColor3 = Color3.fromRGB(130,155,210),
        Font = Enum.Font.GothamBold, TextSize = 11,
        ZIndex = 15, Parent = iconF,
    })

    local nameL = Create("TextLabel", {
        Size = UDim2.new(1,-40,1,0), Position = UDim2.new(0,36,0,0),
        BackgroundTransparency = 1, Text = def.name,
        TextColor3 = Color3.fromRGB(120,140,190), Font = Enum.Font.Gotham,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 14, Parent = btn,
    })

    local activePip = Create("Frame", {
        Size = UDim2.new(0,3,0,18), Position = UDim2.new(1,-6,0.5,-9),
        BackgroundColor3 = CT(), BackgroundTransparency = 1,
        ZIndex = 14, Parent = btn,
    })
    Corner(activePip, 2)
    RegisterThemed(activePip, "BackgroundColor3", "accent")

    local page = Create("ScrollingFrame", {
        Name = def.name .. "_Page", Size = UDim2.new(1,-4,1,0),
        Position = UDim2.new(0,0,0,0), BackgroundTransparency = 1,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(50,65,110),
        CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, ZIndex = 12, Parent = ContentArea,
    })
    Padding(page, 10)
    VList(page, 7)

    TabData[def.name] = {
        Btn = btn, NameLabel = nameL, Pip = activePip,
        IconFrame = iconF, Page = page,
    }
    btn.MouseButton1Click:Connect(function() SetTab(def.name) end)
    btn.MouseEnter:Connect(function()
        if ActiveTab ~= def.name then Tween(btn, { BackgroundTransparency = 0.9 }, 0.12) end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= def.name then Tween(btn, { BackgroundTransparency = 1 }, 0.12) end
    end)
end

SetTab = function(name)
    for k, d in pairs(TabData) do
        local on = k == name
        if on then
            Tween(d.Btn, { BackgroundTransparency = 0.82 }, 0.18)
            Tween(d.NameLabel, { TextColor3 = Color3.fromRGB(210,225,255) }, 0.18)
            Tween(d.Pip, { BackgroundTransparency = 0 }, 0.18)
            Tween(d.IconFrame, { BackgroundTransparency = 0.55 }, 0.18)
            d.Page.Visible = true
        else
            Tween(d.Btn, { BackgroundTransparency = 1 }, 0.18)
            Tween(d.NameLabel, { TextColor3 = Color3.fromRGB(120,140,190) }, 0.18)
            Tween(d.Pip, { BackgroundTransparency = 1 }, 0.18)
            Tween(d.IconFrame, { BackgroundTransparency = 0.75 }, 0.18)
            d.Page.Visible = false
        end
    end
    ActiveTab = name
end

for _, def in ipairs(TABS) do MakeTabBtn(def) end

