        BackgroundTransparency = 1, Text = title, TextColor3 = accent,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 202, Parent = card,
    })
    Create("TextLabel", {
        Size = UDim2.new(1,-20,0,18), Position = UDim2.new(0,12,0,26),
        BackgroundTransparency = 1, Text = msg,
        TextColor3 = Color3.fromRGB(160,170,200), Font = Enum.Font.Gotham,
        TextSize = 11, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 202, Parent = card,
    })
    card.BackgroundTransparency = 1
    Tween(card, { BackgroundTransparency = 0.15 }, 0.3)
    task.delay(dur, function()
        Tween(card, { BackgroundTransparency = 1 }, 0.25)
        task.wait(0.3); card:Destroy()
    end)
end

