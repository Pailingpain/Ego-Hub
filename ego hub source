-- ============================================================

local function CleanLightingFx()
    DisabledLightFx = {}
    for _, obj in ipairs(Lighting:GetChildren()) do
        local c = obj.ClassName
        local target = nil
        if c == "BloomEffect" and Config.CleanMode.RemoveBloom then target = obj
        elseif c == "BlurEffect" and Config.CleanMode.RemoveBlur then target = obj
        elseif c == "ColorCorrectionEffect" and Config.CleanMode.RemoveColorCorrection then target = obj
        elseif c == "DepthOfFieldEffect" then target = obj
        elseif c == "SunRaysEffect" then target = obj
        elseif c == "Atmosphere" then
            table.insert(DisabledLightFx, { obj = obj, prop = "Density", original = obj.Density })
            pcall(function() obj.Density = 0 end)
        end
        if target then
            table.insert(DisabledLightFx, { obj = target, prop = "Enabled", original = target.Enabled })
            pcall(function() target.Enabled = false end)
        end
    end
end

local function RestoreLightingFx()
    for _, e in ipairs(DisabledLightFx) do
        if e.obj and e.obj.Parent then
            pcall(function() e.obj[e.prop] = e.original end)
        end
    end
    DisabledLightFx = {}
end

local function ApplyCleanMode()
    if not Config.CleanMode.Enabled then
        Lighting.FogEnd = OriginalLighting.FogEnd
        Lighting.FogStart = OriginalLighting.FogStart
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        RestoreLightingFx()
        return
    end
    if Config.CleanMode.RemoveFog then Lighting.FogEnd = 999999; Lighting.FogStart = 999998 end
    if Config.CleanMode.RemoveShadows then Lighting.GlobalShadows = false end
    if Config.CleanMode.HideBillboards then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BillboardGui") then pcall(function() obj.Enabled = false end) end
        end
    end
    CleanLightingFx()
end

