local function SerializeConfig()
    -- Strip non-serializable fields
    local copy = {
        ESP = {}, SilentAim = {}, CamLock = {}, AimLock = {},
        AntiLag = {}, CleanMode = {}, FPSChecker = {}, UI = {},
    }
    for k, v in pairs(Config.ESP) do copy.ESP[k] = v end
    for k, v in pairs(Config.SilentAim) do copy.SilentAim[k] = v end
    for k, v in pairs(Config.CamLock) do
        if k ~= "Active" and k ~= "Target" then copy.CamLock[k] = v end
    end
    for k, v in pairs(Config.AimLock) do
        if k ~= "Active" and k ~= "Target" then copy.AimLock[k] = v end
    end
    for k, v in pairs(Config.AntiLag) do copy.AntiLag[k] = v end
    for k, v in pairs(Config.CleanMode) do copy.CleanMode[k] = v end
    for k, v in pairs(Config.FPSChecker) do copy.FPSChecker[k] = v end
    copy.UI.Theme = CurrentTheme
    copy.UI.AutoLoad = Config.UI.AutoLoad
    copy.UI.AutoLoadName = Config.UI.AutoLoadName
    return HttpService:JSONEncode(copy)
end

local function ApplyLoadedConfig(data)
    for k, v in pairs(data.ESP or {}) do Config.ESP[k] = v end
    for k, v in pairs(data.SilentAim or {}) do Config.SilentAim[k] = v end
    for k, v in pairs(data.CamLock or {}) do
        if k ~= "Active" and k ~= "Target" then Config.CamLock[k] = v end
    end
    for k, v in pairs(data.AimLock or {}) do
        if k ~= "Active" and k ~= "Target" then Config.AimLock[k] = v end
    end
    for k, v in pairs(data.AntiLag or {}) do Config.AntiLag[k] = v end
    for k, v in pairs(data.CleanMode or {}) do Config.CleanMode[k] = v end
    for k, v in pairs(data.FPSChecker or {}) do Config.FPSChecker[k] = v end
    if data.UI and data.UI.Theme then ApplyTheme(data.UI.Theme) end
    if data.UI then
        Config.UI.AutoLoad = data.UI.AutoLoad or false
        Config.UI.AutoLoadName = data.UI.AutoLoadName or "default"
    end
    HUDFrame.Visible = Config.FPSChecker.ShowHUD
    ApplyCleanMode()
    if Config.AntiLag.Enabled then ApplyAntiLag() end
end

local function SaveConfigToFile(name)
    if not hasFiles then return false, "Executor doesn't support file APIs" end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    local ok, err = pcall(function() writefile(path, SerializeConfig()) end)
    return ok, err
end

local function LoadConfigFromFile(name)
    if not hasFiles then return false, "No file support" end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false, "Not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok then return false, "Parse error" end
    ApplyLoadedConfig(data)
    return true
end

local function DeleteConfigFile(name)
    if not hasFiles then return false end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    pcall(function() delfile(path) end)
    return true
end

local function ListConfigs()
    if not hasFiles then return {} end
    local out = {}
    pcall(function()
        for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
            local fname = f:match("([^/\\]+)%.json$")
            if fname then table.insert(out, fname) end
        end
    end)
    return out
end

