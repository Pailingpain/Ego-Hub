local ESPObjects = {}

local function GetCharData(player)
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not head or not hum then return nil end
    return char, hrp, head, hum
end

local function MakeESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    if not hasDrawing then return end

    local d = {}
    pcall(function()
        d.Box = Drawing.new("Square")
        d.Box.Visible = false; d.Box.Thickness = 1.5; d.Box.Filled = false
        d.Box.ZIndex = 5

        d.NameLabel = Drawing.new("Text")
        d.NameLabel.Visible = false; d.NameLabel.Size = 14; d.NameLabel.Center = true
        d.NameLabel.Outline = true; d.NameLabel.OutlineColor = Color3.fromRGB(0,0,0)
        d.NameLabel.Font = Drawing.Fonts.UI; d.NameLabel.ZIndex = 6

        d.HealthBG = Drawing.new("Square")
        d.HealthBG.Visible = false; d.HealthBG.Filled = true
        d.HealthBG.Color = Color3.fromRGB(0,0,0); d.HealthBG.ZIndex = 5

        d.HealthFill = Drawing.new("Square")
        d.HealthFill.Visible = false; d.HealthFill.Filled = true; d.HealthFill.ZIndex = 6

        d.DistLabel = Drawing.new("Text")
        d.DistLabel.Visible = false; d.DistLabel.Size = 12; d.DistLabel.Center = true
        d.DistLabel.Outline = true; d.DistLabel.OutlineColor = Color3.fromRGB(0,0,0)
        d.DistLabel.Font = Drawing.Fonts.UI; d.DistLabel.Color = Color3.fromRGB(200,200,200)
        d.DistLabel.ZIndex = 6

        d.Tracer = Drawing.new("Line")
        d.Tracer.Visible = false; d.Tracer.Thickness = 1; d.Tracer.ZIndex = 4
    end)

    if d.Box then ESPObjects[player] = d end
end

local function RemoveESP(player)
    local d = ESPObjects[player]
    if not d then return end
    for _, obj in pairs(d) do pcall(function() obj:Remove() end) end
    ESPObjects[player] = nil
end

local function UpdateESP()
    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for player, d in pairs(ESPObjects) do
        local function hide() for _, obj in pairs(d) do pcall(function() obj.Visible = false end) end end

        if not Config.ESP.Enabled or not localHRP then hide() continue end
        local char, hrp, head, hum = GetCharData(player)
        if not char or not hrp or not head or not hum then hide() continue end
        if hum.Health <= 0 then hide() continue end

        if not Config.ESP.ShowTeammates then
            if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then hide() continue end
        end

        local dist = (hrp.Position - localHRP.Position).Magnitude
        if dist > Config.ESP.MaxDistance then hide() continue end

        local topWorld = head.Position + Vector3.new(0, 0.7, 0)
        local bottomWorld = hrp.Position - Vector3.new(0, 3, 0)
        local topSc, topOn = Camera:WorldToViewportPoint(topWorld)
        local bottomSc, bottomOn = Camera:WorldToViewportPoint(bottomWorld)

        if not topOn and not bottomOn then hide() continue end

        local height = math.abs(topSc.Y - bottomSc.Y)
        local width = height * 0.45
        local boxX = topSc.X - width / 2
        local boxY = topSc.Y

        local accent = CT()

        if Config.ESP.BoxESP then
            d.Box.Visible = true
            d.Box.Position = Vector2.new(boxX, boxY)
            d.Box.Size = Vector2.new(width, height)
            d.Box.Color = accent
        else d.Box.Visible = false end

        if Config.ESP.NameESP then
            d.NameLabel.Visible = true
            d.NameLabel.Text = player.DisplayName
            d.NameLabel.Color = Color3.fromRGB(255,255,255)
            d.NameLabel.Position = Vector2.new(topSc.X, boxY - 18)
        else d.NameLabel.Visible = false end

        if Config.ESP.HealthBar then
            local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local barH = height * hp
            local barX = boxX - 6
            d.HealthBG.Visible = true
            d.HealthBG.Position = Vector2.new(barX, boxY)
            d.HealthBG.Size = Vector2.new(4, height)
            d.HealthFill.Visible = true
            d.HealthFill.Position = Vector2.new(barX, boxY + height - barH)
            d.HealthFill.Size = Vector2.new(4, barH)
            d.HealthFill.Color = Color3.fromRGB((1-hp)*255, hp*255, 0)
        else d.HealthBG.Visible = false; d.HealthFill.Visible = false end

        if Config.ESP.DistanceESP then
            d.DistLabel.Visible = true
            d.DistLabel.Text = string.format("[%dm]", math.floor(dist))
            d.DistLabel.Position = Vector2.new(topSc.X, boxY + height + 2)
        else d.DistLabel.Visible = false end

        if Config.ESP.TracerESP then
            d.Tracer.Visible = true
            d.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            d.Tracer.To = Vector2.new(topSc.X, boxY + height/2)
            d.Tracer.Color = accent
        else d.Tracer.Visible = false end
    end
end

