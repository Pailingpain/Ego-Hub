local hudLocked = false
local hudDragging = false
local hudHoldStart = nil
local hudDragStart, hudStartPos

HUDFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        hudHoldStart = tick()
        if not hudLocked then
            hudDragging = true
            hudDragStart = input.Position
            hudStartPos = HUDFrame.Position
        end
        -- Hold-to-toggle-lock detection
        task.spawn(function()
            local pressedAt = hudHoldStart
            task.wait(0.4)
            if hudHoldStart == pressedAt and (input.UserInputState == Enum.UserInputState.Begin or hudDragging) then
                -- still held
                hudLocked = not hudLocked
                HUDLockIcon.Text = hudLocked and "馃敀" or "馃敁"
                HUDLockIcon.TextColor3 = hudLocked and Color3.fromRGB(255,180,60) or Color3.fromRGB(150,165,210)
                hudDragging = false
                Notify("HUD", hudLocked and "Position locked" or "Position unlocked", "info", 1.5)
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if hudDragging and not hudLocked and (input.UserInputType == Enum.UserInputType.MouseMovement
                                       or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - hudDragStart
        HUDFrame.Position = UDim2.new(
            hudStartPos.X.Scale, hudStartPos.X.Offset + delta.X,
            hudStartPos.Y.Scale, hudStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        hudDragging = false
        hudHoldStart = nil
    end
end)

