local CurrentTheme = "Blue"
local ThemedObjects = {} -- { obj, prop, kind } kind: "accent"|"glow"

local function RegisterThemed(obj, prop, kind)
    table.insert(ThemedObjects, { obj = obj, prop = prop, kind = kind })
end

local function ApplyTheme(name)
    if not Themes[name] then return end
    CurrentTheme = name
    local t = Themes[name]
    for _, e in ipairs(ThemedObjects) do
        if e.obj and e.obj.Parent then
            pcall(function() e.obj[e.prop] = e.kind == "glow" and t.glow or t.accent end)
        end
    end
end

local function CT() return Themes[CurrentTheme].accent end
local function CTglow() return Themes[CurrentTheme].glow end

