local function ExecCmd(raw)
    raw = raw:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if raw == "" then return end
    for _, def in ipairs(Commands) do
        if def.cmd == raw then def.action(); return end
    end
    Notify("Unknown", '"' .. raw .. '"', "error")
end

