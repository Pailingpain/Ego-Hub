-- Try autoload
if hasFiles then
    pcall(function()
        if isfile(AUTOLOAD_FILE) then
            local data = HttpService:JSONDecode(readfile(AUTOLOAD_FILE))
            if data.AutoLoad and data.AutoLoadName then
                local ok = LoadConfigFromFile(data.AutoLoadName)
                if ok then
                    task.wait(0.5)
                    Notify("Autoload", "Loaded: " .. data.AutoLoadName, "success")
                end
            end
        end
    end)
end

